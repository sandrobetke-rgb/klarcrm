# Kopieren nach .env und anpassen
PORT=8080
DB_PASSWORD=bitte-aendern
# Langer Zufallswert, z. B.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=bitte-aendern
ADMIN_EMAIL=admin@firma.de
# Wer das Änderungsprotokoll öffnen darf (SuperUser, leer = ADMIN_EMAIL)
SUPERUSER_EMAIL=
ADMIN_PASSWORD=bitte-aendern
COMPANY_NAME=Meine Firma GmbH
DEFAULT_TAX_RATE=19

# Interner Betrieb
APP_URL=https://crm.firma.local
MAX_UPLOAD_MB=50
# E-Mail über internen Mailserver (optional – ohne SMTP nur Hinweise in der Anwendung)
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM=klarcrm@firma.local
