{
  "name": "KlarCRM – Testumgebung",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "KlarCRM", "onAutoForward": "openBrowser" }
  },
  "postStartCommand": "bash .devcontainer/start.sh"
}
